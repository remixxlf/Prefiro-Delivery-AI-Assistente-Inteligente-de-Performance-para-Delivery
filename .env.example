APP_NAME="Prefiro Delivery AI"
APP_ENV=local
APP_KEY=base64:u1+Z5v/Oq4mG1aE6rW8tN0xY9pL2kJ3bV4cF5eR7tP8=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Sao_Paulo

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─── Banco de Dados ───────────────────────────
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=prefiro_delivery
DB_USERNAME=prefiro
DB_PASSWORD=secret
DB_ROOT_PASSWORD=rootsecret

# ─── Cache & Queue ────────────────────────────
CACHE_STORE=file
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# ─── Inteligência Artificial ──────────────────
# Provedor: groq | openrouter | gemini | openai | anthropic
AI_PROVIDER=
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-r1:free

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=2000
OPENAI_TEMPERATURE=0.3

# Gemini (alternativo)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Anthropic (alternativo)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-haiku-20240307

# Limite de tokens por chamada e custo estimado
AI_TOKEN_LIMIT_PER_REQUEST=4000
AI_COST_LOG_ENABLED=true

# ─── Rate Limiting ────────────────────────────
AI_RATE_LIMIT_PER_MINUTE=20
AI_CACHE_TTL_SECONDS=3600

# ─── Vite / Frontend ─────────────────────────
VITE_APP_NAME="${APP_NAME}"
VITE_API_URL="${APP_URL}/api"